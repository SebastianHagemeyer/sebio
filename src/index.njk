---
layout: base.njk
title: Hallam Interactives
hideHome: true
hideHeader: true
bodyClass: catalog
---

{# The hub supplies its own brand bar and subject nav, so base.njk's plain
   header is suppressed above with hideHeader. Everything below is driven by
   src/_data/catalog.json: add a resource there, not here. #}

<div class="sitebar">
  <div class="wrap">
    <div class="brand">
      <span class="brand-mark" aria-hidden="true">H</span>
      <div class="brand-text">
        <h1>{{ catalog.site.name }}</h1>
        <p>{{ catalog.site.tagline }}</p>
      </div>
    </div>
  </div>
</div>

<nav class="subjectnav" aria-label="Subjects">
  <ul>
    {% for subject in catalog.subjects %}
    <li><a href="#{{ subject.id }}">{{ subject.label }}</a></li>
    {% endfor %}
  </ul>
</nav>

<main>
  {% for subject in catalog.subjects %}
  <section class="subject-section" id="{{ subject.id }}">
    <div class="subject-head">
      <h2>{{ subject.label }}</h2>
      {%- if subject.blurb %}
      <p>{{ subject.blurb }}</p>
      {%- endif %}
    </div>

    {% for group in subject.groups %}
    <div class="catalog-section">
      {#- Only label the group when a subject has more than one, otherwise the
          heading just repeats the subject name back at you. -#}
      {%- if subject.groups.length > 1 %}
      <p class="group-label">{{ group.group }}</p>
      {%- endif %}
      <div class="sim-grid">
        {% for item in group.items %}
        <a class="sim-link{% if item.featured %} featured{% endif %}"
           href="{{ item.href }}"
           {%- if item.external %} rel="noopener"{% endif %}>
          {%- if item.tag %}
          <span class="sim-tag">{{ item.tag }}</span>
          {%- endif %}
          <div class="sim-title">{{ item.title }}</div>
          <div class="sim-desc">{{ item.desc }}</div>
          <span class="sim-go" aria-hidden="true">
            {%- if item.external %}Open site &nearr;{% else %}Explore &rarr;{% endif -%}
          </span>
        </a>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </section>
  {% endfor %}
</main>

<footer class="sitefoot">
  <div class="wrap">
    <p>{{ catalog.site.byline }}</p>
  </div>
</footer>

{# Subject tabs: show one subject at a time, Mathematics (the first) by default.
   Progressive enhancement, so with JS off every subject stays visible. The
   script body is wrapped in raw so Nunjucks never parses it. #}
<script>
{% raw %}
(function () {
  var body = document.body;
  var nav = document.querySelector('.subjectnav');
  var sections = Array.prototype.slice.call(document.querySelectorAll('.subject-section'));
  if (!nav || !sections.length) return;
  var links = Array.prototype.slice.call(nav.querySelectorAll('a[href^="#"]'));
  if (!links.length) return;

  body.classList.add('js-tabs');

  function activate(id, updateHash) {
    if (!document.getElementById(id)) id = sections[0].id;
    sections.forEach(function (s) {
      s.classList.toggle('is-active', s.id === id);
    });
    links.forEach(function (a) {
      var on = a.getAttribute('href') === '#' + id;
      a.classList.toggle('is-active', on);
      if (on) { a.setAttribute('aria-current', 'true'); }
      else { a.removeAttribute('aria-current'); }
    });
    if (updateHash && window.history && history.replaceState) {
      history.replaceState(null, '', '#' + id);
    }
    window.scrollTo(0, 0);
  }

  links.forEach(function (a) {
    a.addEventListener('click', function (e) {
      var id = a.getAttribute('href').slice(1);
      if (document.getElementById(id)) {
        e.preventDefault();
        activate(id, true);
      }
    });
  });

  window.addEventListener('hashchange', function () {
    var id = location.hash.slice(1);
    if (id && document.getElementById(id)) activate(id, false);
  });

  var initial = location.hash.slice(1);
  activate(initial && document.getElementById(initial) ? initial : sections[0].id, false);
}());
{% endraw %}
</script>
