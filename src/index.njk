---
layout: base.njk
title: Interactive Biology Simulations
subtitle: by Sebastian Hagemeyer
tagline: Select a module to explore
hideHome: true
bodyClass: catalog
---

<main>
  {% for group in catalog %}
  <section class="catalog-section">
    <h2>{{ group.category }}</h2>
    <div class="sim-grid">
      {% for item in group.items %}
      <a class="sim-link" href="{{ item.href }}">
        <div class="sim-title">{{ item.title }}</div>
        <div class="sim-desc">{{ item.desc }}</div>
      </a>
      {% endfor %}
    </div>
  </section>
  {% endfor %}
</main>
