<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/globalstyle.css" />
    {%- if headExtra %}
    {{ headExtra | safe }}
    {%- endif %}
  </head>
  <body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    {%- if not hideHeader %}
    {% include "partials/header.njk" %}
    {%- endif %}
    {{ content | safe }}
    {%- if modal %}
    {% include "partials/modal.njk" %}
    {%- endif %}
  </body>
</html>
